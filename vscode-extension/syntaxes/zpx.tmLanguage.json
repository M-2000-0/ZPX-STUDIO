{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ZPX",
  "scopeName": "source.zpx",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#decorators" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#variables" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.zpx",
          "match": "#.*$"
        },
        {
          "name": "comment.block.zpx",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zpx",
          "match": "\\b(if|el|else|elif|for|in|while|break|continue|return|ret|pass|end|match|case|test|doc|check|expect|requires|ensures|concurrent|channel)\\b"
        },
        {
          "name": "keyword.declaration.zpx",
          "match": "\\b(fn|class|let|mut|const|type|enum|struct|interface|schema|api|service|database|import|from|as|expose|export|version|permission)\\b"
        },
        {
          "name": "keyword.operator.logical.zpx",
          "match": "\\b(and|or|not|in|is)\\b"
        },
        {
          "name": "keyword.operator.boolean.zpx",
          "match": "\\b(true|false|none|null|undefined)\\b"
        },
        {
          "name": "keyword.special.zpx",
          "match": "\\b(self|super|this|ret|raise|exit|wait|print|say|show|ask)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.zpx",
          "match": "\\b(true|false|none|null|undefined|pi|e|inf|nan)\\b"
        },
        {
          "name": "constant.other.zpx",
          "match": "[A-Z][A-Z0-9_]+\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zpx",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.zpx",
              "match": "\\\\[nrt\\\\\"']"
            },
            {
              "name": "variable.other.interpolated.zpx",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                { "include": "#expressions" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.zpx",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.zpx",
              "match": "\\\\[nrt\\\\\"']"
            }
          ]
        },
        {
          "name": "string.quoted.triple.zpx",
          "begin": "\"\"\"",
          "end": "\"\"\""
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.zpx",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.zpx",
          "match": "\\b\\d+[eE][+-]?\\d+\\b"
        },
        {
          "name": "constant.numeric.hex.zpx",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.zpx",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.octal.zpx",
          "match": "\\b0[oO]?[0-7]+\\b"
        },
        {
          "name": "constant.numeric.integer.zpx",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function-call.zpx",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.zpx"
            }
          }
        },
        {
          "name": "meta.function-definition.zpx",
          "begin": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.zpx"
            },
            "2": {
              "name": "entity.name.function.zpx"
            }
          },
          "end": "(?=\\S)",
          "patterns": [
            {
              "name": "variable.parameter.zpx",
              "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=[:,=])"
            }
          ]
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "annotation.zpx",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.zpx",
          "match": "\\b(int|float|str|bool|list|dict|tuple|set|none|any|void|never)\\b"
        },
        {
          "name": "storage.type.zpx",
          "match": "\\b(let|mut|const|fn|class|type|struct|enum)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.zpx",
          "match": "=|\\+=|-=|\\*=|/=|%=|\\*\\*="
        },
        {
          "name": "keyword.operator.arithmetic.zpx",
          "match": "\\+|-|\\*|/|%|\\*\\*"
        },
        {
          "name": "keyword.operator.comparison.zpx",
          "match": "==|!=|<|>|<=|>=|<>"
        },
        {
          "name": "keyword.operator.logical.zpx",
          "match": "and|or|not|&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.member.zpx",
          "match": "\\.|\\?\\."
        },
        {
          "name": "keyword.operator.spread.zpx",
          "match": "\\.\\.\\.|\\*"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.zpx",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "variable.parameter.zpx",
          "match": "\\bself\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.block.zpx",
          "match": ":"
        },
        {
          "name": "punctuation.separator.zpx",
          "match": ","
        },
        {
          "name": "punctuation.definition.array.zpx",
          "match": "\\[|\\]"
        },
        {
          "name": "punctuation.definition.group.zpx",
          "match": "\\(|\\)"
        },
        {
          "name": "punctuation.definition.dictionary.zpx",
          "match": "\\{|\\}"
        },
        {
          "name": "punctuation.definition.string.zpx",
          "match": "\"|'"
        }
      ]
    },
    "expressions": {
      "patterns": [
        { "include": "#constants" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#functions" },
        { "include": "#variables" },
        { "include": "#operators" }
      ]
    }
  }
}
